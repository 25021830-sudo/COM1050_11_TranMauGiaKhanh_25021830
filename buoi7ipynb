    "#HW7\n",
    "def longest_ascending_list(nums):\n",
    "    if not nums:\n",
    "        return 0\n",
    "\n",
    "    # Khởi tạo danh sách L, mặc định mỗi phần tử tự thân nó là dãy con độ dài 1\n",
    "    n = len(nums)\n",
    "    L = [1] * n\n",
    "\n",
    "    # Duyệt qua từng phần tử\n",
    "    for i in range(1, n):\n",
    "        # Kiểm tra tất cả các phần tử đứng trước nó\n",
    "        for j in range(i):\n",
    "            if nums[j] < nums[i]:\n",
    "                # Nếu số trước nhỏ hơn, cập nhật độ dài tại i\n",
    "                L[i] = max(L[i], L[j] + 1)\n",
    "\n",
    "    return max(L)\n",
    "\n",
    "# Chạy thử với các ví dụ trong ảnh:\n",
    "print(longest_ascending_list([10, 9, 2, 5, 3,4, 7, 101, 18]))\n",
    "print(longest_ascending_list([0, 1, 0, 3, 2, 3]))\n",
    "print(longest_ascending_list([7, 7, 7, 7, 7, 7, 7]))"
