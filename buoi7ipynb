    "#HW1\n",
    "def binary_search(string, num):\n",
    "    left = 0\n",
    "    right = len(string) - 1\n",
    "    mid = (left + right)//2\n",
    "    while left <= right and right > 0:\n",
    "        if string[mid] > num:\n",
    "            right -= 1\n",
    "            mid = (left + right)//2\n",
    "        if string[mid] < num:\n",
    "            left +=1\n",
    "            mid = (left + right)//2\n",
    "        if string[mid] == num:\n",
    "            return mid + 1\n",
    "    return -1\n",
    "string = list(map(int,input().split()))\n",
    "num = int(input())\n",
    "print(binary_search(string,num))"
