    "#HW3\n",
    "def bubble_sort(string):\n",
    "    for j in range(len(string)):\n",
    "        swap = False\n",
    "        for i in range(0, len(string)-j-1):\n",
    "            if string[i] > string[i+1]:\n",
    "                string[i+1], string[i] = string[i], string[i+1]\n",
    "                swap = True\n",
    "        if not swap:\n",
    "            break\n",
    "    return string\n",
    "\n",
    "def selection_sort(string):\n",
    "    for i in range(len(string)):\n",
    "        min_index = i\n",
    "        for j in range(i+1,len(string)):\n",
    "            if string[j] < string[min_index]:\n",
    "                min_index = j\n",
    "        string[i], string[min_index] = string[min_index], string[i]\n",
    "    return string\n",
    "\n",
    "\n",
    "\n",
    "string = list(map(int,input().split()))\n",
    "print(bubble_sort(string))\n",
    "print(selection_sort(string))\n"
   ],
